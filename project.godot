; Engine configuration file.
; PROJECT MARKET — combat playground

config_version=5

[application]

config/name="PROJECT MARKET"
run/main_scene="res://world/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.62, 0.57, 0.49, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":90)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":81)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
dash={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"physical_keycode":4194325)]
}
shoot={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
market={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}
drop_loot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":71)]
}
cargo_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
cargo_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
cargo_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Targets"
3d_physics/layer_3="Player"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=18.0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.72, 0.67, 0.58, 1)
