[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/market_panel.gd" id="1_panel"]

[sub_resource type="StyleBoxFlat" id="Style_panel"]
bg_color = Color(0.105, 0.118, 0.112, 0.97)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
