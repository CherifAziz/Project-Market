corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_right = 5
corner_radius_bottom_left = 5
shadow_color = Color(0.03, 0.04, 0.035, 0.62)
shadow_size = 18

[node name="MarketPanel" type="CanvasLayer"]
visible = false
layer = 30
script = ExtResource("1_panel")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0.035, 0.042, 0.04, 0.72)

[node name="Center" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -340.0
offset_top = -342.0
offset_right = 340.0
offset_bottom = 342.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("Style_panel")

[node name="Margin" type="MarginContainer" parent="Center"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Center/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="MarketHeader" type="Label" parent="Center/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.74, 0.69, 1)
theme_override_font_sizes/font_size = 13
text = "PROJECT MARKET  //  LIVE COMPANIES"

[node name="MarketSubtitle" type="Label" parent="Center/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.53, 0.56, 0.52, 1)
theme_override_font_sizes/font_size = 10
