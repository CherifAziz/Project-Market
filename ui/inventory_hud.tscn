[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/inventory_hud.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="Style_cargo"]
bg_color = Color(0.075, 0.093, 0.083, 0.94)
